{
	"name": "wordcount",
	"version": "1.0.0",
	"scripts": {
		"ng": "ng",
		"dev": "ng serve",
		"build": "ng build",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"lint:prettier": "prettier . --write",
		"lint:all": "npm run lint:prettier && npm run lint:fix"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^21.0.0",
		"@angular/compiler": "^21.0.0",
		"@angular/core": "^21.0.0",
		"@angular/forms": "^21.0.0",
		"@angular/platform-browser": "^21.0.0",
		"@angular/router": "^21.0.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^21.0.3",
		"@angular/cli": "^21.0.3",
		"@angular/compiler-cli": "^21.0.0",
		"@biomejs/biome": "2.3.10",
		"@tailwindcss/postcss": "4.1.18",
		"jsdom": "^27.1.0",
		"postcss": "^8.5.3",
		"prettier": "3.7.4",
		"tailwindcss": "4.1.18",
		"typescript": "~5.9.2",
		"vitest": "4.0.15"
	}
}
