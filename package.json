{
	"name": "wordcount",
	"version": "1.0.0",
	"scripts": {
		"ng": "ng",
		"dev": "ng serve",
		"build": "ng build",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"lint:prettier": "prettier . --write",
		"lint:all": "npm run lint:prettier && npm run lint:fix"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"dependencies": {
		"@angular/common": "21.1.4",
		"@angular/compiler": "21.1.4",
		"@angular/core": "21.1.4",
		"@angular/forms": "21.1.4",
		"@angular/platform-browser": "21.1.4",
		"@angular/router": "21.1.4",
		"@angular/service-worker": "21.1.4",
		"rxjs": "~7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@angular/build": "21.1.4",
		"@angular/cli": "21.1.4",
		"@angular/compiler-cli": "21.1.4",
		"@biomejs/biome": "2.4.0",
		"@tailwindcss/postcss": "4.1.18",
		"postcss": "8.5.6",
		"prettier": "3.8.1",
		"tailwindcss": "4.1.18",
		"typescript": "~5.9.3",
		"vitest": "4.0.18"
	}
}
